# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in what you need. Everything is optional:
# with no keys at all the pipeline still runs using the offline heuristic
# highlight picker.
# ---------------------------------------------------------------------------

# --- LLM highlight detection -----------------------------------------------
# Options: gemini | groq | manual | heuristic | nim | openrouter | cerebras |
#          together | ollama | lmstudio | openai
#   manual    = paste the prompt into claude.ai yourself, paste the JSON back.
#               Costs nothing beyond a subscription you already have.
#   heuristic = fully offline scoring, no key, no chat window.
#   ollama    = local model on your own machine, unlimited forever.
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.7

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Any OpenAI-compatible endpoint ---------------------------------------
# Presets fill base_url + model automatically; these override them.
# NVIDIA NIM:   NVIDIA_API_KEY=nvapi-...     --provider nim
# OpenRouter:   OPENROUTER_API_KEY=sk-or-... --provider openrouter
# Cerebras:     CEREBRAS_API_KEY=...         --provider cerebras
# Ollama:       (no key)                     --provider ollama
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# OPENAI_API_KEY=

# --- Transcription ---------------------------------------------------------
WHISPER_MODEL=small          # tiny|base|small|medium|large-v3|distil-large-v3
WHISPER_DEVICE=auto          # auto|cpu|cuda
WHISPER_COMPUTE_TYPE=auto    # auto|int8|float16|float32
# WHISPER_LANGUAGE=en        # leave blank to auto-detect
WHISPER_VAD=true

# --- Clip selection --------------------------------------------------------
# highlights = best isolated moments | story = chronological series
# sequential = mechanical chop, no LLM
CLIP_STRATEGY=highlights
CLIP_COUNT=5
CLIP_PART_TARGET=50          # story/sequential: preferred part length (s)
CLIP_PART_GAP_TOLERANCE=4    # gaps smaller than this get closed, losing nothing
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=20

# --- Rendering -------------------------------------------------------------
REFRAME_MODE=blur            # blur|crop|face
OUT_WIDTH=1080
OUT_HEIGHT=1920
OUT_FPS=30
OUT_CRF=20
OUT_PRESET=veryfast
LOUDNORM=true
FG_HEIGHT_RATIO=0.62

# --- Captions --------------------------------------------------------------
CAPTION_FONT=Arial Black     # Linux: try "DejaVu Sans" or install the font
CAPTION_FONT_SIZE=86
CAPTION_COLOR_IDLE=&H00FFFFFF        # white   (ASS = &HAABBGGRR)
CAPTION_COLOR_ACTIVE=&H0000E5FF      # amber
CAPTION_MARGIN_V=400
CAPTION_UPPERCASE=true
CAPTION_MAX_WORDS=4
# CAPTION_FONTS_DIR=./fonts

# --- Publishing ------------------------------------------------------------
PUBLISH_SEMI_AUTO=true
YOUTUBE_CLIENT_SECRETS=client_secrets.json
YOUTUBE_TOKEN_FILE=youtube_token.json
YOUTUBE_PRIVACY=private      # private|unlisted|public - start private!
DEFAULT_HASHTAGS=

LOG_LEVEL=INFO